# Bundle artifact
*.jsbundle

# JS bundle generated by `react-native bundle` / release Gradle builds
android/app/src/main/assets/

# Recursos copiados junto com o bundle (--assets-dest): imagens do LogBox do
# React Native e o keep.xml. Sao recriados a cada bundle, como o proprio bundle.
android/app/src/main/res/drawable-*/node_modules_*
android/app/src/main/res/raw/keep.xml

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# testing
/coverage

